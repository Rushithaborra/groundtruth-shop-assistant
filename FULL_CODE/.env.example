# Copy to .env and edit, then load it into your shell before running:  set -a; . ./.env; set +a
# Every variable is optional; config.json holds the defaults. No secrets are needed: everything runs offline.

# Use a different settings file
# GROUNDTRUTH_CONFIG=config.json

# The problem pack's files (put them under data/pack/, which git ignores)
GROUNDTRUTH_CATALOGUE=data/pack/catalogue.jsonl
GROUNDTRUTH_POLICY=data/pack/policy.txt

# The provided offline models (put them under models/, which git ignores)
GROUNDTRUTH_EMBED_MODEL=models/embedding-model
GROUNDTRUTH_LLM_MODEL=models/instruct-model

# Web demo
GROUNDTRUTH_HOST=127.0.0.1
GROUNDTRUTH_PORT=8000

# DEBUG, INFO, WARNING or ERROR
GROUNDTRUTH_LOG_LEVEL=INFO

# Where web chats are kept: memory (this process, default) or sqlite (a file shared by processes, kept across restarts)
# GROUNDTRUTH_SESSION_BACKEND=sqlite
# GROUNDTRUTH_SESSION_DB=output/sessions.sqlite
